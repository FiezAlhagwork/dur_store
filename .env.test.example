# Copy this file to `.env.test` and fill in the values.
#
# `.env.test` is git-ignored on purpose and belongs ONLY on a developer
# machine — never on a server. The E2E suite creates and deletes real
# products and categories through the API, so the absence of this file
# anywhere else is what keeps it from ever running against live store data.
#
# Clerk keys are deliberately NOT listed here: they are read from
# `.env.local` (see the comment at the top of playwright.config.ts), so the
# tests always use the same Clerk instance as the dev server they drive.

# An existing Clerk account whose role in the Laravel database is "customer".
E2E_CUSTOMER_EMAIL=

# An existing Clerk account whose role in the Laravel database is "admin".
# Roles are never self-assigned: sign up normally, then change `role` to
# "admin" directly in the database (see CLAUDE.md → Roles).
E2E_ADMIN_EMAIL=

# Used by the test that drives the real sign-in UI (e2e/auth-email-otp.spec.ts).
# Must follow Clerk's test-mode convention — any address whose local part
# contains `+clerk_test`, e.g. you+clerk_test@example.com — which always
# accepts the fixed code 424242 and never sends a real email. The account
# has to exist already; create it once through /register, since /login
# rejects an unknown identifier outright.
E2E_OTP_CUSTOMER_EMAIL=

# Where the suite points. The local dev server must already be running:
# playwright.config.ts has no `webServer`, so `npm run dev` first.
PLAYWRIGHT_BASE_URL=http://localhost:3000
